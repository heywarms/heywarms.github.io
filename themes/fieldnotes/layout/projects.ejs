<section class="shell projects-page">
  <header class="page-intro"><h1><span class="project-title-lead">想法，</span>也可以有形状</h1><p>从自己的问题出发，把想法做成用得上的工具。这里收藏正在认真打磨的作品。</p></header>
  <% (theme.projects || []).forEach((project, index) => { %>
  <article class="project-case" id="<%= project.slug %>">
    <div class="project-case-heading"><div><p class="eyebrow"><%= String(index + 1).padStart(2, '0') %> / <%= project.label %></p><h2><%= project.title %></h2><p><%= project.tagline %></p></div><span class="project-status"><span class="live-dot"></span><%= project.status %></span></div>
    <% if (project.image) { %><figure class="project-case-image"><button type="button" class="photo-button" data-photo-view aria-label="放大 <%= project.title %> 界面截图"><img src="<%= url_for(project.image) %>" alt="<%= project.image_alt %>" width="2327" height="1317" loading="lazy"></button><figcaption><%= project.image_alt %></figcaption></figure><% } %>
    <div class="project-case-body"><div class="project-case-story"><h3>为什么做它</h3><p><%= project.description %></p><ul class="project-stack" aria-label="项目使用的技术"><% (project.stack || []).forEach(item => { %><li><%= item %></li><% }); %></ul><% if (project.source_url) { %><a class="button button-dark" href="<%= project.source_url %>" target="_blank" rel="noopener noreferrer">查看 GitHub 项目 <%- fn_icon('northeast') %></a><% } %></div><ol class="project-features"><% (project.features || []).forEach((feature, featureIndex) => { %><li><span aria-hidden="true"><%= String(featureIndex + 1).padStart(2, '0') %></span><div><h3><%= feature.title %></h3><p><%= feature.description %></p></div></li><% }); %></ol></div>
  </article>
  <% }); %>
  <% if (!(theme.projects || []).length) { %><div class="empty-state"><h2>还没有作品。</h2><a class="text-link" href="<%= url_for('/about/') %>">先认识一下 <%- fn_icon('arrow') %></a></div><% } %>
  <div class="collection-other"><span>作品之外，也记录过程</span><a class="text-link" href="<%= url_for('/topics/') %>">去专题书架逛逛 <%- fn_icon('arrow') %></a><a class="text-link" href="<%= url_for('/about/') %>">更多关于我 <%- fn_icon('northeast') %></a></div>
</section>
