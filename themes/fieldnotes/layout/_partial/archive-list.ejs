<section class="shell archive-page"><div class="page-intro"><p class="eyebrow">THE WRITING ROOM</p><h1><%= heading %><span class="title-dot">.</span></h1><p><%= subtitle %></p></div>
<nav class="topic-nav" aria-label="文章分类"><a href="<%= url_for('/archives/') %>"<% if(is_archive() && !page.year) { %> aria-current="page"<% } %>>全部文章 <span><%= fn_posts().length %></span></a><a href="<%= url_for('/categories/') %>">分类</a><a href="<%= url_for('/tags/') %>">标签</a></nav>
<% let lastYear = ''; posts.forEach(post => { const year = date(post.date, 'YYYY'); if (year !== lastYear) { if(lastYear) { %></div><% } lastYear = year; %><div class="archive-year"><h2><%= year %><span>年</span></h2><% } %><a class="archive-row" href="<%= url_for(post.path) %>"><time datetime="<%= date_xml(post.date) %>"><%= date(post.date,'MM / DD') %></time><div><h3><%= post.title %></h3><p><%= fn_excerpt(post,100) %></p><span><%= fn_categories(post).map(c=>c.name).join(' / ') || '随记' %> · <%= fn_minutes(post) %> 分钟阅读</span></div><%- fn_icon('northeast') %></a><% }); if(lastYear) { %></div><% } %>
<% if(!posts.length) { %><div class="empty-state"><h2>这里的故事，即将开始。</h2><a class="text-link" href="<%= url_for('/') %>">回到首页 <%- fn_icon('arrow') %></a></div><% } %>
<% if(paginate && page.total > 1) { %><nav class="pagination" aria-label="文章分页"><%- paginator({prev_text:'上一页', next_text:'下一页', mid_size:1}) %></nav><% } %>
</section>
