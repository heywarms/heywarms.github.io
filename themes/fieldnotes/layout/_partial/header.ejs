<header class="site-header shell">
  <a class="brand" href="<%= url_for('/') %>" aria-label="<%= config.title %>，首页">
    <% const avatar = fn_settings().brand_avatar; %><% if (avatar) { %><span class="brand-mark has-avatar" aria-hidden="true"><img src="<%= fn_media(avatar) %>" alt="" width="44" height="44"></span><% } %>
    <span><strong><%- fn_wordmark(theme.brand || config.title) %></strong><small><%= config.title %></small></span>
  </a>
  <nav class="primary-nav" id="primary-nav" aria-label="主导航">
    <% fn_settings().navigation.forEach(item => { %><a href="<%= fn_url(item.url) %>"<% if (fn_nav_active(item.url)) { %> aria-current="page"<% } %><% if (item.new_tab) { %> target="_blank" rel="noopener noreferrer"<% } %>><%= item.title %></a><% }); %>
  </nav>
  <div class="header-actions">
    <% if (fn_settings().features.search) { %><button class="icon-button" type="button" data-open-search aria-label="搜索文章" hidden><%- fn_icon('search') %></button><% } %>
    <% if (fn_settings().appearance.toggle) { %><button class="icon-button theme-toggle" type="button" aria-label="切换深色模式" data-toggle-theme hidden><%- fn_icon('moon','moon-icon') %><%- fn_icon('sun','sun-icon') %></button><% } %>
    <% if (fn_settings().navigation.length) { %><button class="icon-button menu-toggle" type="button" aria-label="展开导航" aria-expanded="false" aria-controls="primary-nav" data-toggle-menu hidden><%- fn_icon('menu') %></button><% } %>
  </div>
</header>
