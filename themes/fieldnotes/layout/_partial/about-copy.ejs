<div class="about-copy" id="profile"><h2><%= theme.about.heading %></h2><p><%= theme.about.description %></p><p><%= theme.about.note %></p><dl class="profile-facts"><dt>正在打磨</dt><dd><a href="<%= url_for('/projects/') %>"><%= theme.about.focus || '技术 · 创造 · 生活' %></a></dd><dt>持续记录</dt><dd><%= fn_posts().length %> 篇文章</dd><dt>当前状态</dt><dd><%= fn_settings().about.status %></dd></dl><div class="interest-list"><% (theme.about.interests || []).forEach(item=>{ %><span><%= item %></span><% }); %></div><% if(theme.social && theme.social.github) { %><a class="button button-dark" href="<%= theme.social.github %>" target="_blank" rel="noopener noreferrer">在 GitHub 找到我 <%- fn_icon('northeast') %></a><% } %><% if(page.content && strip_html(page.content).trim()) { %><div class="prose about-content"><%- page.content %></div><% } %></div>
