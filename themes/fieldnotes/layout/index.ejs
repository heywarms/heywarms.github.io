<% if (page.current && page.current > 1) { %>
<%- partial('_partial/archive-list', { heading: '文章归档', subtitle: '全部文章，按时间排列。', posts: fn_posts(page.posts), paginate: true }) %>
<% } else { const home = fn_settings().home; let sectionNumber = 0; %>
<% home.order.forEach(key => {
  if (key === 'topics' && !fn_topics().length) return;
  if (key === 'projects' && !(theme.projects || []).length) return;
  if (key === 'routes' && !home.routes.items.length) return;
  if (key === 'glossary' && !home.glossary.items.length) return;
  if (['topics', 'featured', 'projects', 'journal', 'routes', 'glossary', 'videos', 'updates', 'connect'].includes(key)) sectionNumber++;
%><%- partial('_home/' + key, {section: home[key], number: String(sectionNumber).padStart(2, '0')}) %><% }); %>
<% } %>
