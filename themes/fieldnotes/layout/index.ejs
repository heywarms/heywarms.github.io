<% if (page.current && page.current > 1) { %><%- partial('_partial/archive-list', { heading: '文章归档', subtitle: '每一篇记录，都是一次新的发现。', posts: fn_posts(page.posts), paginate: true }) %><% } else { %>
<section class="hero shell">
  <div class="hero-copy"><p class="eyebrow"><span class="live-dot"></span><%= theme.hero.eyebrow %></p><h1><%= theme.hero.line_one %><br><span><%= theme.hero.line_two %></span></h1><p class="hero-intro"><%= theme.hero.introduction %></p><div class="hero-actions"><a class="button button-dark" href="#selected">读点什么 <%- fn_icon('arrow') %></a><a class="text-link" href="<%= url_for('/about/') %>">认识一下 <%- fn_icon('northeast') %></a></div><p class="hero-annotation"><svg viewBox="0 0 40 28" aria-hidden="true"><path d="M2 3c2 21 18 23 32 15m-9-5 10 4-5 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><%= theme.hero.annotation %></p></div>
  <%- partial('_partial/locker', {lockerMode: 'home'}) %>
</section>
<div class="interlude shell"><span><%- fn_icon('code') %> 写代码</span><i></i><span>记灵感</span><i></i><span>去生活</span><p>Good things take curiosity.</p><span class="interlude-arrow">↓</span></div>
<section class="section shell" id="selected"><div class="section-heading"><div><p class="eyebrow">01 / SELECTED NOTES</p><h2>值得慢慢读的几篇<span class="title-dot">.</span></h2></div><a class="text-link" href="<%= url_for('/archives/') %>">全部文章 <%- fn_icon('northeast') %></a></div>
  <div class="featured-grid"><% fn_featured().forEach(item => { const post = item.post; %><article class="featured-post"><a href="<%= url_for(post.path) %>" class="featured-link"><%- partial('_partial/post-art', {artwork:item.artwork}) %><div class="featured-meta"><span><%= item.label %></span><span><%= fn_minutes(post) %> 分钟</span></div><h3><%= post.title %><%- fn_icon('northeast') %></h3><p><%= item.description || fn_excerpt(post, 70) %></p></a></article><% }); %></div>
</section>
<section class="section shell journal-section"><div class="journal-main"><div class="section-heading"><div><p class="eyebrow">02 / THE JOURNAL</p><h2>最近，写了这些<span class="title-dot">.</span></h2></div></div><div class="post-rows"><% fn_posts().slice(0, 5).forEach(post => { %><a class="post-row" href="<%= url_for(post.path) %>"><time datetime="<%= date_xml(post.date) %>"><span><%= date(post.date, 'MM.DD') %></span><small><%= date(post.date,'YYYY') %></small></time><div><span class="row-category"><%= fn_categories(post).map(c=>c.name).join(' / ') || '随记' %></span><h3><%= post.title %></h3></div><%- fn_icon('northeast') %></a><% }); %></div><a class="text-link journal-more" href="<%= url_for('/archives/') %>">翻翻全部 <%= fn_posts().length %> 篇记录 <%- fn_icon('arrow') %></a></div>
  <aside class="life-teaser"><p class="eyebrow">OFF THE SCREEN</p><h2>生活也值得<br><em>认真收藏。</em></h2><a href="<%= url_for('/life/') %>" class="life-teaser-image" aria-label="查看生活切片"><img src="<%= url_for('/images/fieldnotes-landscape.svg') %>" alt="日落与层叠山峦的插画" width="360" height="280" loading="lazy"></a><p>留一点时间给日落，<br>也留一点好奇给明天。</p><a class="text-link" href="<%= url_for('/life/') %>">生活切片 <%- fn_icon('arrow') %></a></aside>
</section>
<section class="about-strip shell"><span class="strip-flower" aria-hidden="true">✳</span><div><p class="eyebrow">ALWAYS EXPLORING</p><h2>一个持续更新中的人。</h2><p>在这里，想法可以不完整，热爱可以很具体。</p></div><a class="button button-outline" href="<%= url_for('/about/') %>">更多关于我 <%- fn_icon('northeast') %></a></section>
<% } %>
