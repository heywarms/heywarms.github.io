<section class="section shell" id="selected"><div class="section-heading"><div><p class="eyebrow"><%= number %> / <%= section.eyebrow %></p><h2><%= section.title %></h2></div><a class="text-link" href="<%= url_for('/archives/') %>"><%= section.link_text %> <%- fn_icon('northeast') %></a></div>
  <div class="featured-grid"><% fn_featured(section.limit).forEach(item => { const post = item.post; %><article class="featured-post"><a href="<%= url_for(post.path) %>" class="featured-link"><%- partial('_partial/post-art', {artwork:item.artwork}) %><div class="featured-meta"><span><%= item.label %></span><span><%= fn_minutes(post) %> 分钟</span></div><h3><%= post.title %><%- fn_icon('northeast') %></h3><p><%= item.description || fn_excerpt(post, 70) %></p></a></article><% }); %></div>
</section>
