<% const v = section; const post = fn_find_post(v.post); const title = v.cover_title || (post && post.title) || ''; const watch = v.video_url ? fn_url(v.video_url) : ''; const read = post ? url_for(post.path) : ''; const href = watch || read; const external = fn_external(watch);
const icons = {note: '<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5M10 13h6M10 17h6"/>', image: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="m4 16 4.5-4.5 3.5 3.5 2.5-2.5L20 18"/><circle cx="15.5" cy="8.5" r="1.5"/>', copy: '<rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/>', link: '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>', next: '<path d="M5 12h14M13 6l6 6-6 6"/>'};
const icon = name => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + icons[name] + '</svg>'; %>
<% if (title) { %>
<section class="deck-section" id="videos">
  <div class="cinema-shell">
    <%- partial('_partial/deck-heading', {number, eyebrow: v.eyebrow, title: v.title, description: v.description, link_text: v.link_text, link_url: v.link_url}) %>
    <div class="videos-layout">
      <article class="deck-card videos-feature">
        <<%= href ? 'a' : 'div' %> class="videos-cover<%= v.poster ? '' : ' is-abstract' %>"<% if (href) { %> href="<%= href %>"<% if (external) { %> target="_blank" rel="noopener noreferrer"<% } %><% } %>>
          <% if (v.poster) { %><img src="<%= fn_media(v.poster) %>" alt="" loading="lazy"><% } else { %><span class="episode-orb" aria-hidden="true"></span><% } %>
          <span class="videos-shade" aria-hidden="true"></span>
          <% if (v.label) { %><span class="videos-label"><%= v.label %></span><% } %>
          <span class="videos-cover-title"><%= title %></span>
          <% if (href) { %><span class="videos-play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg></span><% } %>
        </<%= href ? 'a' : 'div' %>>
        <div class="videos-meta">
          <div><p class="videos-title"><%= v.video_title || title %></p><% if (v.meta || v.duration) { %><p class="videos-sub"><%= [v.meta, v.duration].filter(Boolean).join(' · ') %></p><% } %></div>
          <% if (watch) { %><a class="deck-button" href="<%= watch %>"<% if (external) { %> target="_blank" rel="noopener noreferrer"<% } %>><%= v.watch_text %> <%- fn_icon('northeast') %></a><% } %>
        </div>
      </article>
      <aside class="videos-extras" aria-label="这一期的配套">
        <p class="videos-extras-title">这一期的配套</p>
        <% if (post) { %><a class="deck-card deck-tilt videos-extra" href="<%= read %>"><span class="videos-extra-icon"><%- icon('note') %></span><span><strong>文字版笔记：<%= post.title %></strong><small>约 <%= fn_minutes(post) %> 分钟读完</small></span></a><% } %>
        <% v.extras.forEach(extra => { const tag = extra.url ? 'a' : 'div'; %><<%= tag %> class="deck-card<%= extra.url ? ' deck-tilt' : '' %> videos-extra"<% if (extra.url) { %> href="<%= fn_url(extra.url) %>"<% if (fn_external(extra.url)) { %> target="_blank" rel="noopener noreferrer"<% } %><% } %>><span class="videos-extra-icon is-<%= extra.icon %>"><%- icon(extra.icon) %></span><span><strong><%= extra.title %></strong><% if (extra.note) { %><small><%= extra.note %></small><% } %></span></<%= tag %>><% }); %>
      </aside>
    </div>
    <% if (v.more.length) { %><div class="deck-grid videos-more"><% v.more.forEach((item, index) => { const tag = item.url ? 'a' : 'div'; %><<%= tag %> class="deck-card deck-tilt videos-more-card tone-<%= index % 3 %>"<% if (item.url) { %> href="<%= fn_url(item.url) %>"<% if (fn_external(item.url)) { %> target="_blank" rel="noopener noreferrer"<% } %><% } %>><% if (item.label) { %><span class="videos-label"><%= item.label %></span><% } %><strong><%= item.title %></strong></<%= tag %>><% }); %></div><% } %>
  </div>
</section>
<% } %>
