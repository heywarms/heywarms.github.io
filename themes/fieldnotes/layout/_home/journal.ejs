<section class="section shell journal-section<%= section.show_life ? '' : ' without-life' %>"><div class="journal-main"><div class="section-heading"><div><p class="eyebrow"><%= number %> / <%= section.eyebrow %></p><h2><%= section.title %></h2></div></div><div class="post-rows"><% fn_posts().slice(0, section.limit).forEach(post => { %><a class="post-row" href="<%= url_for(post.path) %>"><time datetime="<%= date_xml(post.date) %>"><span><%= date(post.date, 'MM.DD') %></span><small><%= date(post.date,'YYYY') %></small></time><div><span class="row-category"><%= fn_categories(post).map(c=>c.name).join(' / ') || '随记' %></span><h3><%= post.title %></h3></div><%- fn_icon('northeast') %></a><% }); %></div><a class="text-link journal-more" href="<%= url_for('/archives/') %>">翻翻全部 <%= fn_posts().length %> 篇记录 <%- fn_icon('arrow') %></a></div>
  <% if (section.show_life) { %><aside class="life-teaser"><p class="eyebrow">OFF THE SCREEN</p><h2>生活也值得<br><em>认真收藏。</em></h2><a href="<%= url_for('/life/') %>" class="life-teaser-image" aria-label="查看生活切片"><img src="<%= url_for('/images/fieldnotes-landscape.svg') %>" alt="日落与层叠山峦的插画" width="360" height="280" loading="lazy"></a><p>留一点时间给日落，<br>也留一点好奇给明天。</p><a class="text-link" href="<%= url_for('/life/') %>">生活切片 <%- fn_icon('arrow') %></a></aside><% } %>
</section>
