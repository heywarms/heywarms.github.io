<div class="reading-progress" aria-hidden="true"><span></span></div>
<article class="shell post-page"><header class="post-header"><a class="text-link back-link" href="<%= url_for('/archives/') %>"><%- fn_icon('back') %> 回到文章</a><div class="post-categories"><% fn_categories(page).forEach(category=>{ %><a href="<%= url_for(category.path) %>"><%= category.name %></a><% }); %></div><h1><%= page.title %></h1><div class="post-meta"><time datetime="<%= date_xml(page.date) %>"><%= date(page.date,'YYYY 年 MM 月 DD 日') %></time><span>·</span><span><%= fn_minutes(page) %> 分钟阅读</span><span>·</span><span><%= config.author || config.title %></span></div></header>
<div class="reading-layout"><div class="post-body"><div class="prose" id="article-content"><%- page.content %></div><div class="post-end"><span aria-hidden="true">✳</span><p>感谢你读到这里。<br><small>愿这篇记录，刚好对你有用。</small></p><button class="button button-outline" type="button" data-copy-link hidden>分享这篇 <%- fn_icon('northeast') %></button></div><% if(page.tags && page.tags.length) { %><div class="post-tags"><% page.tags.forEach(tag=>{ %><a href="<%= url_for(tag.path) %>"># <%= tag.name %></a><% }); %></div><% } %><nav class="post-navigation" aria-label="前后文章"><% if(page.prev) { %><a href="<%= url_for(page.prev.path) %>"><small>上一篇</small><strong><%= page.prev.title %></strong></a><% } %><% if(page.next) { %><a href="<%= url_for(page.next.path) %>"><small>下一篇</small><strong><%= page.next.title %></strong></a><% } %></nav></div><aside class="post-toc"><div><p class="eyebrow">ON THIS PAGE</p><h2>阅读目录</h2><%- toc(page.content, {list_number:false, max_depth:3}) %><a class="toc-top" href="#main">回到顶部 ↑</a></div></aside></div></article>
