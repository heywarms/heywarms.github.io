<% const kind = page.type || page.layout; const isAbout = kind === 'about' || page.path === 'about/index.html'; const isCategories = kind === 'categories' || page.path === 'categories/index.html'; const isTags = kind === 'tags' || page.path === 'tags/index.html'; %>
<% if (isAbout) { %>
<% const about = fn_settings().about; const hero = about.hero.enabled; %>
<% if (hero) { %><%- partial('_partial/about-hero', {about}) %><% } %>
<section class="shell about-page<%= hero ? ' has-hero' : '' %>"><% if (!hero) { %><div class="page-intro"><% if (about.eyebrow) { %><p class="eyebrow"><%= about.eyebrow %></p><% } %><h1><%= about.title %></h1><p><%= theme.tagline %></p></div><% } %><div class="about-layout"><% if (!hero) { %><%- partial('_partial/cabinet', {lockerMode: 'about'}) %><% } %><%- partial('_partial/about-copy') %></div><% if (about.show_projects && (theme.projects || []).length) { %><section class="section about-workbench" aria-labelledby="about-work-heading"><div class="section-heading"><div><h2 id="about-work-heading">最近在做的东西</h2></div></div><%- partial('_partial/project-spotlight') %></section><% } %></section>
<% } else if (isCategories || isTags) { const items = (isCategories ? site.categories : site.tags).toArray().filter(item=>item.length > 0).sort((a,b)=>b.length-a.length); %>
<section class="shell taxonomy-page"><div class="page-intro"><h1><%= isCategories ? '分类' : '标签' %></h1><p><%= items.length %> 个<%= isCategories ? '分类' : '标签' %>，点进去看对应的文章。</p></div><nav class="topic-nav"><a href="<%= url_for('/archives/') %>">全部文章</a><a href="<%= url_for('/categories/') %>"<% if(isCategories) { %> aria-current="page"<% } %>>分类</a><a href="<%= url_for('/tags/') %>"<% if(isTags) { %> aria-current="page"<% } %>>标签</a></nav><div class="taxonomy-grid"><% items.forEach((item,index)=>{ %><a href="<%= url_for(item.path) %>"><span class="eyebrow"><%= String(index + 1).padStart(2,'0') %></span><h2><%= isTags ? '# ' : '' %><%= item.name %></h2><span><%= item.length %> 篇文章 <%- fn_icon('northeast') %></span></a><% }); %></div><% if(!items.length) { %><div class="empty-state"><h2>还没有内容。</h2><a class="text-link" href="<%= url_for('/archives/') %>">先看看全部文章 <%- fn_icon('arrow') %></a></div><% } %></section>
<% } else { %>
<article class="shell basic-page"><div class="page-intro"><h1><%= page.title %></h1></div><div class="prose"><%- page.content %></div></article>
<% } %>
