<% const kind = page.type || page.layout; const isAbout = kind === 'about' || page.path === 'about/index.html'; const isCategories = kind === 'categories' || page.path === 'categories/index.html'; const isTags = kind === 'tags' || page.path === 'tags/index.html'; %>
<% if (isAbout) { %>
<section class="shell about-page"><div class="page-intro"><p class="eyebrow">A PERSON, NOT JUST A PROFILE</p><h1>关于我<span class="title-dot">.</span></h1><p><%= theme.tagline %></p></div><div class="about-layout"><%- partial('_partial/locker', {lockerMode: 'about'}) %><div class="about-copy" id="profile"><h2><%= theme.about.heading %></h2><p><%= theme.about.description %></p><p><%= theme.about.note %></p><dl class="profile-facts"><dt>正在探索</dt><dd>技术 · 创造 · 生活</dd><dt>持续记录</dt><dd><%= fn_posts().length %> 篇文章</dd><dt>当前状态</dt><dd>保持好奇，持续更新</dd></dl><div class="interest-list"><% (theme.about.interests || []).forEach(item=>{ %><span><%= item %></span><% }); %></div><% if(theme.social && theme.social.github) { %><a class="button button-dark" href="<%= theme.social.github %>" target="_blank" rel="noopener noreferrer">在 GitHub 找到我 <%- fn_icon('northeast') %></a><% } %><% if(page.content && strip_html(page.content).trim()) { %><div class="prose about-content"><%- page.content %></div><% } %></div></div></section>
<% } else if (isCategories || isTags) { const items = (isCategories ? site.categories : site.tags).toArray().filter(item=>item.length > 0).sort((a,b)=>b.length-a.length); %>
<section class="shell taxonomy-page"><div class="page-intro"><p class="eyebrow">FOLLOW YOUR CURIOSITY</p><h1><%= isCategories ? '按主题探索' : '灵感的关键词' %><span class="title-dot">.</span></h1><p>换一个入口，发现一篇想读的文章。</p></div><nav class="topic-nav"><a href="<%= url_for('/archives/') %>">全部文章</a><a href="<%= url_for('/categories/') %>"<% if(isCategories) { %> aria-current="page"<% } %>>分类</a><a href="<%= url_for('/tags/') %>"<% if(isTags) { %> aria-current="page"<% } %>>标签</a></nav><div class="taxonomy-grid"><% items.forEach((item,index)=>{ %><a href="<%= url_for(item.path) %>"><span class="eyebrow"><%= String(index + 1).padStart(2,'0') %> / COLLECTION</span><h2><%= isTags ? '# ' : '' %><%= item.name %></h2><span><%= item.length %> 篇文章 <%- fn_icon('northeast') %></span></a><% }); %></div><% if(!items.length) { %><div class="empty-state"><h2>关键词，还在慢慢积累。</h2><a class="text-link" href="<%= url_for('/archives/') %>">先看看全部文章 <%- fn_icon('arrow') %></a></div><% } %></section>
<% } else { %>
<article class="shell basic-page"><div class="page-intro"><p class="eyebrow">A PAGE FROM MY JOURNAL</p><h1><%= page.title %><span class="title-dot">.</span></h1></div><div class="prose"><%- page.content %></div></article>
<% } %>
