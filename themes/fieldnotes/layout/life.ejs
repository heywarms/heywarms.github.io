<% const lifePosts = fn_posts().filter(post=>fn_is_life(post)); const photos = theme.life.photos || []; %>
<section class="shell life-page"><div class="life-page-heading"><div class="page-intro"><p class="eyebrow">LIFE, BETWEEN THE LINES</p><h1>生活切片<span class="title-dot">.</span></h1><p><%= theme.life.description %></p></div><span class="life-script">Take it slow.</span></div>
<% if(photos.length) { %><div class="photo-grid"><% photos.forEach(photo=>{ %><figure><button type="button" class="photo-button" data-photo-view aria-label="放大：<%= photo.alt || photo.caption || '生活照片' %>"><img src="<%= url_for(photo.src) %>" alt="<%= photo.alt || photo.caption || '' %>" loading="lazy" width="640" height="480"></button><figcaption><%= photo.caption || '' %></figcaption></figure><% }); %></div><% } else { %><div class="life-canvas"><img src="<%= url_for('/images/fieldnotes-landscape.svg') %>" alt="原创插画：日落与层叠山峦" width="1200" height="700"><div><span class="eyebrow">A MOMENT OF STILLNESS</span><h2><%= theme.life.title %></h2><span class="life-canvas-label">山海之间 / 主题插画</span></div></div><% } %>
<% if(lifePosts.length) { %><div class="section-heading life-entries"><div><p class="eyebrow">LITTLE MOMENTS</p><h2>日常里的小事</h2></div></div><div class="post-rows"><% lifePosts.forEach(post=>{ %><a class="post-row" href="<%= url_for(post.path) %>"><time><span><%= date(post.date,'MM.DD') %></span><small><%= date(post.date,'YYYY') %></small></time><div><span class="row-category"><%= fn_categories(post).map(c=>c.name).join(' / ') %></span><h3><%= post.title %></h3></div><%- fn_icon('northeast') %></a><% }); %></div><% } else { %><div class="life-note"><span aria-hidden="true">✳</span><p>一些生活里的故事，正在路上。<br><small>不着急，先把每一天过得具体。</small></p><a class="text-link" href="<%= url_for('/archives/') %>">去读一篇文章 <%- fn_icon('arrow') %></a></div><% } %></section>
