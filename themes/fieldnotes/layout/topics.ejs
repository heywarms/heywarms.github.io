<% const topics = fn_topics(); const hero = fn_settings().topic_hero.enabled && topics.length > 1; %>
<% if (hero) { %><%- partial('_partial/topic-hero', {topics}) %><% } %>
<section class="shell collections-page" id="topic-shelf">
  <header class="page-intro"<% if (hero) { %> hidden<% } %>><h1>把知识，连成线</h1><p>把同一个问题里的笔记放在一起。从第一篇开始，也可以直接翻到你需要的那一页。</p></header>
  <nav class="topic-nav" aria-label="文章浏览方式"><a href="<%= url_for('/topics/') %>" aria-current="page">专题书架</a><a href="<%= url_for('/archives/') %>">全部文章</a><a href="<%= url_for('/categories/') %>">分类</a><a href="<%= url_for('/tags/') %>">标签</a></nav>
  <% if (fn_topics().length) { %><section aria-labelledby="topics-heading"><h2 class="sr-only" id="topics-heading">选择一个阅读专题</h2><%- partial('_partial/topic-cards') %></section><% } else { %><div class="empty-state"><h2>还没有专题。</h2><a class="text-link" href="<%= url_for('/archives/') %>">先翻翻全部文章 <%- fn_icon('arrow') %></a></div><% } %>
</section>
